# Public pages build and run with no environment file. Copy to ignored .env.local.
# Server-only: never add NEXT_PUBLIC_ prefixes or commit real credentials.
APP_ORIGIN=http://localhost:3000
MONGODB_URI=
MONGODB_DB_NAME=make_my_marriage_dev
AUTH_SECRET=
# A separate random 32-byte base64 key. Keep it stable for persisted email payloads.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=identity-v1

# simulated: persists encrypted messages, makes no provider calls, never verifies users.
# test: sends only if the intended account equals EMAIL_TEST_RECIPIENT.
# live: requires a verified sender domain.
EMAIL_MODE=simulated
# Optional local-only access exception. Requires next dev, a loopback APP_ORIGIN,
# a database name ending in _dev/_test, simulated email, and no Vercel runtime.
# Ignores email verification for access without changing stored verification dates.
DEV_SKIP_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
# Stable namespace shared by deployments spending the same provider allowance.
EMAIL_QUOTA_NAMESPACE=
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
# Required in test/live; ISO timestamps aligned with the provider reset window.
EMAIL_MONTH_WINDOW_START=
EMAIL_MONTH_WINDOW_END=

# Future private photo integration (not implemented).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_LIMIT_BYTES=8000000000
MAX_PHOTO_BYTES=20000000
