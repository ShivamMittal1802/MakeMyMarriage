# The initial shell runs without an environment file or external services.
# Copy to .env.local only when configuring integrations. Never commit secrets.
# All variables below are server-only; do not add NEXT_PUBLIC_ prefixes.
APP_ORIGIN=http://localhost:3000
EMAIL_MODE=simulated

# Future database and identity integration (not implemented in the scaffold).
MONGODB_URI=
MONGODB_DB_NAME=
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=

# Future email integration. Simulated mode must never contact Resend.
# Test mode requires the actual controlled Resend account email.
# Set the monthly allowance and provider-aligned reset windows before sending.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=

# Future private photo integration. Limits are shared across all weddings.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_LIMIT_BYTES=8000000000
MAX_PHOTO_BYTES=20000000
