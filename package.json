{
  "name": "make-my-marriage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrations/001-identity.ts",
    "email:reconcile": "node --conditions=react-server --import tsx scripts/reconcile-identity-email.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth-http": "npm run build && vitest run --config vitest.http.config.mts",
    "db:migrate:events": "node --conditions=react-server --import tsx scripts/migrations/003-events.ts",
    "db:migrate:weddings": "node --conditions=react-server --import tsx scripts/migrations/002-weddings.ts"
  },
  "dependencies": {
    "@fastify/csrf": "8.1.1",
    "@next/env": "16.4.6",
    "@node-rs/argon2": "2.2.2",
    "mongoose": "9.12.3",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "mongodb-memory-server-core": "11.4.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
